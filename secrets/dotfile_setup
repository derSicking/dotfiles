#!/usr/bin/env bash

set -e

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

# Materialise a real secret file for every tracked *.example skeleton. An
# existing secret is never overwritten, so re-running ./install is safe and
# new skeletons can be added by dropping in another *.example file.
for example in "$SCRIPT_DIR"/*.example; do
  [ -e "$example" ] || continue
  target="${example%.example}"
  if [ -e "$target" ]; then
    echo "$(basename "$target") already exists, skipping"
    continue
  fi
  cp "$example" "$target"
  chmod 600 "$target"
  echo "created $(basename "$target") from $(basename "$example") -- fill it in"
done
